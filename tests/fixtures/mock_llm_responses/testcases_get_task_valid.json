{
  "test_cases": [
    {
      "test_id": "TC-001",
      "endpoint": "/tasks/{task_id}",
      "method": "GET",
      "category": "positive",
      "name": "get existing task",
      "purpose": "verify an existing task can be fetched by id",
      "preconditions": [],
      "request": {
        "path_params": {"task_id": "1"},
        "query_params": {},
        "headers": {"X-API-Key": "AUTH_TOKEN_PLACEHOLDER"},
        "body": null
      },
      "expected_status": 200,
      "assertions": [
        {"type": "status_code", "expected": 200},
        {"type": "field_equals", "field": "id", "expected": 1}
      ],
      "tags": ["smoke"]
    },
    {
      "test_id": "TC-002",
      "endpoint": "/tasks/{task_id}",
      "method": "GET",
      "category": "not_found",
      "name": "get missing task",
      "purpose": "verify a nonexistent task id returns 404",
      "preconditions": [],
      "request": {
        "path_params": {"task_id": "999999"},
        "query_params": {},
        "headers": {"X-API-Key": "AUTH_TOKEN_PLACEHOLDER"},
        "body": null
      },
      "expected_status": 404,
      "assertions": [
        {"type": "status_code", "expected": 404}
      ],
      "tags": []
    },
    {
      "test_id": "TC-003",
      "endpoint": "/tasks/{task_id}",
      "method": "GET",
      "category": "authentication",
      "name": "missing api key",
      "purpose": "verify requests without a valid API key are rejected",
      "preconditions": [],
      "request": {
        "path_params": {"task_id": "1"},
        "query_params": {},
        "headers": {},
        "body": null
      },
      "expected_status": 401,
      "assertions": [
        {"type": "status_code", "expected": 401}
      ],
      "tags": []
    }
  ]
}
