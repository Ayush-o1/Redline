# Copy to .env and fill in. Never commit the real .env file.

# Required for `redline plan|generate|full` (not needed for `validate`,
# `run`, or the test suite -- those never call a real LLM).
OPENAI_API_KEY=

# Optional overrides -- sensible defaults are used if omitted.
LLM_PROVIDER=openai
MODEL=gpt-4o-mini
MAX_RETRIES=2
REQUEST_TIMEOUT=30
OUTPUT_DIR=reports

# The API under test. Omit (or use --demo-app) to run against the bundled
# local demo app instead of a real server.
TARGET_BASE_URL=

# Credential substituted into generated requests wherever a test case sets
# the auth header to the literal placeholder "AUTH_TOKEN_PLACEHOLDER" --
# never sent to the LLM, only used at execution time.
REDLINE_AUTH_TOKEN=
